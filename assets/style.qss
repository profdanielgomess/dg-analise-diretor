* {
    font-family: Segoe UI;
    color: white;
    font-size: 14px;
}

QWidget {
    background-color: #1e1f3b;
}

#menu {
    background-color: #141529;
    border-right: 1px solid #2f315e;
}

#titulo {
    font-size: 30px;
    font-weight: bold;
    padding: 25px;
    color: #00d084;
    qproperty-alignment: AlignCenter;
}

QPushButton {
    background-color: #2a2c4d;
    border: none;
    border-radius: 12px;
    padding: 18px;
    text-align: left;
    font-size: 16px;
    margin-bottom: 10px;
}

QPushButton:hover {
    background-color: #3c3f6e;
}

QPushButton:pressed {
    background-color: #5055a5;
}

#card {
    background-color: #2a2c4d;
    border-radius: 18px;
    padding: 18px;
    border: 1px solid #3b3d68;
}

QLabel {
    background: transparent;
}

QTableWidget {
    background-color: #20213d;
    border: 1px solid #3b3d68;
    border-radius: 10px;
    gridline-color: #3b3d68;
    padding: 8px;
}

QHeaderView::section {
    background-color: #2d3060;
    padding: 10px;
    border: none;
    font-weight: bold;
}

QComboBox {
    background-color: #2a2c4d;
    border-radius: 10px;
    padding: 10px;
    border: 1px solid #3b3d68;
    font-size: 15px;
}